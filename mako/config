layer=overlay
width=300
height=80
margin=10
padding=16
border-radius=10
border-size=2
border-color=#313244
background-color=#1e1e2e
text-color=#cdd6f4
font=DroidSansM Nerd Font 10
default-timeout=5000
max-visible=5
anchor=top-right

[urgency=low]
background-color=#1e1e2e
text-color=#a6e3a1
border-color=#a6e3a1

[urgency=normal]
background-color=#1e1e2e
text-color=#f9e2af
border-color=#f9e2af

[urgency=critical]
background-color=#f5c2e7
text-color=#1e1e2e
border-color=#f38ba8
ignore-timeout=1
