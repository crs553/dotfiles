# Catppuccin Mocha

set notification-error-bg       "#f38ba8"
set notification-error-fg       "#1e1e2e"
set notification-warning-bg     "#f9e2af"
set notification-warning-fg     "#1e1e2e"
set notification-bg             "#1e1e2e"
set notification-fg             "#cdd6f4"

set completion-bg               "#313244"
set completion-fg               "#cdd6f4"
set completion-group-bg         "#45475a"
set completion-group-fg         "#cdd6f4"
set completion-highlight-bg     "#585b70"
set completion-highlight-fg     "#cdd6f4"

set index-bg                    "#181825"
set index-fg                    "#cdd6f4"
set index-active-bg             "#89b4fa"
set index-active-fg             "#1e1e2e"

set inputbar-bg                 "#313244"
set inputbar-fg                 "#cdd6f4"
set statusbar-bg                "#313244"
set statusbar-fg                "#a6adc8"

set highlight-fg                "#cdd6f4"
set highlight-active-color      "rgba(137, 180, 250, 0.5)"
set highlight-color             "rgba(203, 166, 247, 0.5)"

set default-bg                  "#1e1e2e"
set default-fg                  "#cdd6f4"

set render-loading              true
set render-loading-fg           "#cdd6f4"
set render-loading-bg           "#313244"

# Recolor mode settings
set recolor                     true
set recolor-lightcolor          "#1e1e2e"
set recolor-darkcolor           "#cdd6f4"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
map j feedkeys "<C-Down>"
map k feedkeys "<C-Up>"
