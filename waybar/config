{
  "position": "top",
  "height": 35,
  "spacing": 4,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "hyprland/language",
    "hyprland/scratchpad"
  ],
  "modules-center": [
    "hyprland/window",
    "mpris",
    "clock"
  ],
  "modules-right": [
    "idle_inhibitor",
    "custom/power_profile",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "disk",
    "temperature",
    "backlight",
    "battery",
    "tray"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name} {icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "default": ""
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}",
    "on-click": "gnome-calendar"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false,
    "on-click": "kitty --class btop -e btop"
  },
  "memory": {
    "format": "{}% ",
    "on-click": "kitty --class btop -e btop"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": ""
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " "
    ],
    "on-click": "powerprofilesctl"
  },
  "network": {
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "hyprland/window": {
    "rewrite": {
      "(.*) - Brave": " Brave",
      "(.*) — Mozilla Firefox": " Firefox",
      "(.*) — Thunar": " Thunar"
    }
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "US",
    "on-click": "hyprctl switchxkblayout current next"
  },
  "hyprland/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": [
      ""
    ],
    "tooltip": true
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": "",
      "brave": "",
      "mpv": ""
    },
    "status-icons": {
      "playing": "",
      "paused": ""
    },
    "max-length": 50,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "bluetooth": {
    "format": " {status}",
    "format-disabled": " ",
    "format-connected": " {device_alias}",
    "tooltip-format": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "custom/power_profile": {
    "format": "{} {icon}",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    },
    "exec": "powerprofilesctl get",
    "on-click": "powerprofilesctl cycle",
    "interval": 10
  },
  "disk": {
    "format": "{percentage_used}% ",
    "path": "/",
    "interval": 60,
    "on-click": "kitty -e df -h"
  }
}
